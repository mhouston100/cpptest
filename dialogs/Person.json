{
  "default": {
    "steps": [
      { "text": "${name}: Hi there, traveler. The city needs your help." },
      {
        "text": "Will you accept the quest?",
        "choices": [
          { "label": "Yes", "next_step": 2 },
          { "label": "No", "next_step": 3 }
        ]
      },
      { "text": "Excellent! Return when you've completed the task." },
      { "text": "Very well. Come back if you change your mind." }
    ]
  },
  "Person001": {
    "steps": [
      {
        "id": "first_hello",
        "text": "${name}: Hi — I'm new on this floor. Think you can help with a ticket backlog?",
        "cond": { "flag": "met_alex", "equals": false },
        "effects": [{ "set_flag": "met_alex", "value": true }],
        "choices": [
          {
            "label": "I'll help",
            "next_step": "accepted",
            "effects": [
              { "relationship": 10 },
              { "set_flag": "quest_alex", "value": true }
            ]
          },
          {
            "label": "Not now",
            "next_step": "declined",
            "effects": [{ "relationship": -5 }]
          }
        ]
      },
      {
        "id": "repeat",
        "text": "${name}: Hey again. (rel ${relationship})",
        "cond": { "flag": "met_alex" },
        "choices": [
          {
            "label": "Helpdesk posting",
            "next_step": "job_intro"
          },
          {
            "label": "About that backlog",
            "next_step": "quest_status",
            "cond": { "flag": "quest_alex" }
          },
          {
            "label": "Ask a favour",
            "next_step": "favour",
            "cond": { "relationship_min": 60 },
            "effects": [{ "relationship": 4 }]
          },
          {
            "label": "Just saying hi",
            "next_step": "smalltalk",
            "effects": [{ "relationship": 2 }]
          }
        ]
      },
      {
        "id": "accepted",
        "entry": false,
        "text": "Alex grins. Ticket queue's all yours — thanks."
      },
      {
        "id": "declined",
        "entry": false,
        "text": "No rush. The printer can wait... probably."
      },
      {
        "id": "quest_status",
        "entry": false,
        "text": "The backlog is still ugly, but at least someone cares."
      },
      {
        "id": "favour",
        "entry": false,
        "text": "Alex lowers their voice: 'If you ever need a badge swipe, I owe you.'"
      },
      {
        "id": "smalltalk",
        "entry": false,
        "text": "You swap a couple of helpdesk war stories."
      },
      {
        "id": "job_intro",
        "entry": false,
        "text": "Internal listing: helpdesk tech. They want a closed web ticket and the web fundamentals cert.",
        "choices": [
          { "label": "Apply", "next_step": "job_hired" },
          { "label": "Not now", "next_step": "job_later" }
        ]
      },
      {
        "id": "job_hired",
        "entry": false,
        "cond": { "flags_on": ["exp_web", "cert_web"], "flags_off": ["job_helpdesk"] },
        "effects": [{ "apply_job": "helpdesk" }],
        "text": "Alex forwards the packet. You're on the helpdesk roster."
      },
      {
        "id": "job_no_exp",
        "entry": false,
        "cond": { "flags_off": ["exp_web"] },
        "text": "Rejected — no closed web ticket on file. Pull one off the rack first."
      },
      {
        "id": "job_no_cert",
        "entry": false,
        "cond": { "flags_on": ["exp_web"], "flags_off": ["cert_web"] },
        "text": "They like the ticket. Come back when you've got the web fundamentals cert."
      },
      {
        "id": "job_already",
        "entry": false,
        "cond": { "flags_on": ["job_helpdesk"] },
        "text": "You're already on the roster. Don't make Alex do the paperwork twice."
      },
      {
        "id": "job_later",
        "entry": false,
        "text": "Listing stays up. Cert and a closed web ticket — then apply."
      }
    ]
  }
}
