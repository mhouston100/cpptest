{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug cpptest",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cpptest",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build cpptest (Debug)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Avoid NVIDIA/OpenGL hangs while ptraced",
          "text": "set disable-randomization off",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
